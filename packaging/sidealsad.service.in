# Managed by SideALSA installer.
[Unit]
Description=SideALSA physical audio daemon
After=sound.target
Wants=sound.target

[Service]
Type=simple
ExecStart=@PREFIX@/bin/sidealsad --profile @PROFILE@ --socket @SOCKET@
Restart=on-failure
RestartPreventExitStatus=78
RestartSec=2
Group=audio
UMask=0007
# Root-owned 0750 root:audio; /tmp let any user squat the socket path.
RuntimeDirectory=sidealsa
RuntimeDirectoryMode=0750
LimitRTPRIO=99
LimitMEMLOCK=infinity

[Install]
WantedBy=multi-user.target
