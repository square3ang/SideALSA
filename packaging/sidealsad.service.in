# Managed by SideALSA installer.
[Unit]
Description=SideALSA physical audio daemon
After=sound.target systemd-tmpfiles-setup.service
Wants=sound.target

[Service]
Type=simple
ExecStart=@PREFIX@/bin/sidealsad --profile @PROFILE@ --socket @SOCKET@
Restart=on-failure
RestartPreventExitStatus=78
RestartSec=2
Group=audio
UMask=0007
LimitRTPRIO=99
LimitMEMLOCK=infinity

[Install]
WantedBy=multi-user.target
