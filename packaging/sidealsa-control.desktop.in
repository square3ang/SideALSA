[Desktop Entry]
Type=Application
Name=SideALSA Control
Comment=Configure SideALSA hardware timing
Exec=@PREFIX@/bin/sidealsa-control --profile @PROFILE@ --socket @SOCKET@
Icon=@PREFIX@/share/icons/hicolor/512x512/apps/org.sidealsa.Control.png
Terminal=false
Categories=AudioVideo;Audio;
Keywords=audio;ALSA;ASIO;latency;sample rate;
StartupNotify=true
